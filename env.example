# Copia este archivo a ".env" y completa tus valores reales.
# NUNCA subas el archivo ".env" real a un repositorio público.

# Clave de API de Anthropic (Claude) — el "cerebro" del agente
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# --- Meta WhatsApp Cloud API (recomendado) ---
# Token temporal o permanente generado en developers.facebook.com
META_ACCESS_TOKEN=
# ID del número de teléfono de WhatsApp Business en Meta
META_PHONE_NUMBER_ID=
# Token que tú inventas para verificar el webhook con Meta
WHATSAPP_VERIFY_TOKEN=echome-verify-token

# --- Twilio (alternativa) ---
# No requiere variables aquí: Twilio llama directo a /webhook/twilio
# usando el Account SID / Auth Token configurados en tu cuenta de Twilio.

PORT=3000
